# ======================================================================
# PLang Example 5: Error Handling & Visual Caret Diagnostics Demo
# Demonstrates Requirement II.2 (Handling Incorrect Formats & Errors)
# Run with: python main.py examples/error_handling_demo.plang
# ======================================================================

# First, here is a valid calculation that executes without errors:
let safe_number = (25 + 15) * 2
print safe_number

# ----------------------------------------------------------------------
# HOW TO TEST ERROR HANDLING DURING YOUR DEMO:
# Remove the '#' symbol in front of ANY ONE line below and re-run this
# file to see PLang's visual caret (^) error diagnostics and hints!
# ----------------------------------------------------------------------

# 1. LEXICAL ERROR (Unrecognized symbol '@'):
# let bad_symbol = 10 @ 5

# 2. LEXICAL ERROR (Malformed decimal with two dots):
# let bad_float = 12.34.56

# 3. LEXICAL ERROR (Variable name starting with a digit):
# let 2fast = 100

# 4. SYNTAX / FORMAT ERROR (Missing number between '+' and '*'):
# let bad_format = 10 + * 5

# 5. SYNTAX / FORMAT ERROR (Unclosed parenthesis):
# let unclosed = (10 + 20 * 3

# 6. RUNTIME ERROR (Division by zero):
# print 100 / (10 - 10)

# 7. RUNTIME ERROR (Using a variable before defining it):
# print unknown_variable + 10
