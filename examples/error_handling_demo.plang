# ======================================================================
# PLang Example 5: Error Handling & Visual Caret Diagnostics Suite
# Demonstrates Requirement II.2 (Handling Incorrect Formats & Errors)
# Run with: python main.py examples/error_handling_demo.plang
# ======================================================================

# --- 1. LEXICAL ERRORS (Invalid Characters & Malformed Tokens) ---

# Case 1: Unrecognized symbol '@'
10 @ 5

# Case 2: Unrecognized currency symbol '$'
let price = $100

# Case 3: Malformed decimal number (multiple decimal points)
let bad_float = 12.34.56

# Case 4: Invalid variable name starting with a digit
let 2fast = 50

# --- 2. SYNTAX / FORMAT ERRORS (Grammar & Structure Violations) ---

# Case 5: Consecutive binary operators (missing operand between '+' and '*')
25 + * 5

# Case 6: Incomplete expression (missing operand at end of line)
40 +

# Case 7: Missing operator between two numbers
10 20

# Case 8: Unclosed opening parenthesis '('
(10 + 5 * 2

# Case 9: Unmatched closing parenthesis ')'
10 + 5)

# Case 10: Empty parentheses '()'
10 + ()

# Case 11: Missing '=' in 'let' variable declaration
let score 100

# Case 12: Invalid assignment target (assigning to a number literal)
10 = 5

# Case 13: Using a reserved keyword ('print') as a variable name
let print = 10

# Case 14: Empty 'print' statement with no expression
print

# --- 3. RUNTIME / DOMAIN ERRORS (Illegal Math & Undefined State) ---

# Case 15: Division by zero
print 100 / (10 - 10)

# Case 16: Modulo by zero
print 50 % 0

# Case 17: Undefined variable reference
print unknown_var + 10

# Case 18: Square root of a negative number (domain error)
print sqrt(-16)

# Case 19: Numeric exponent overflow (> 10000)
print 2 ^ 50000

# Case 20: Reassigning a protected mathematical constant (PI)
let PI = 3

# Case 21: Wrong number of arguments to a built-in function
print sqrt(4, 9)
