# ======================================================================
# PLang Example 5: Relatable Everyday Life Scenarios
# Run with: python main.py examples/everyday_life.plang
# ======================================================================

# --- 1. Student Daily Baon (Allowance) Tracker ---
let daily_baon = 300
let jeepney_fare = 13 mul 2
let lunch_meal = 85
let iced_coffee = 65

let total_gastos = jeepney_fare add lunch_meal add iced_coffee
let natirang_baon = daily_baon sub total_gastos
print total_gastos
print natirang_baon

# --- 2. Barkada Food Trip Bill Splitter (Whole Peso Split) ---
# Total bill is 1,250 pesos shared among 4 friends
let total_bill = 1250
let barkada_count = 4
let ambag_bawat_isa = total_bill div barkada_count
let sobrang_barya = total_bill mod barkada_count
print ambag_bawat_isa
print sobrang_barya

# --- 3. San Tayo Nagkulang? (Relationship Math) ---
let effort_ko = 100
let effort_niya = NULL
let saan_ba = NULL
let san_tayo = NULL
let san_tayo_nagkulang = saan_ba == san_tayo
print san_tayo_nagkulang

# --- 4. Online Shopping Checkout with Voucher ---
let hoodie_price = 450
let quantity = 2
let shipping_fee = 55
let cart_total = hoodie_price * quantity + shipping_fee
# Apply a 100-peso discount voucher using compound assignment (-=)
cart_total -= 100
print cart_total

